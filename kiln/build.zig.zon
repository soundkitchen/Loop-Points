.{
    // パッケージ名
    .name = .kiln,
    // セマンティックバージョン。build.zig がビルドオプションとしてコアの `kiln.version` に渡す
    .version = "0.0.0",
    // name と組み合わせてパッケージを一意に識別する値。zig が生成したもので、変更しない
    .fingerprint = 0xe9273745d0f76af6, // Changing this has security and trust implications.
    .minimum_zig_version = "0.17.1",
    .dependencies = .{},
    // パッケージとして配らないが、Zig が必須とする欄なので、ディレクトリ全体を指す
    .paths = .{""},
}
